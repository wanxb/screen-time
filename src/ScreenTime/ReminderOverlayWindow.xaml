<Window x:Class="ScreenTime.ReminderOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="休息提醒"
        Icon="Assets/AppIcon.ico"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Maximized"
        Topmost="True"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent"
        KeyDown="OnKeyDown">
    <Window.Resources>
        <Style x:Key="OverlayButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="#45FFFFFF" />
            <Setter Property="BorderBrush" Value="#66FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="21">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryOverlayButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource OverlayButtonStyle}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
    </Window.Resources>

    <Grid x:Name="RootOverlay">
        <Border Width="760"
                Padding="34"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource OverlayCardBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="28">
            <Border.Effect>
                <DropShadowEffect BlurRadius="34"
                                  Direction="270"
                                  Opacity="0.24"
                                  ShadowDepth="14"
                                  Color="#000000" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.35*" />
                    <ColumnDefinition Width="260" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <Border Width="64"
                            Height="64"
                            HorizontalAlignment="Left"
                            Background="{DynamicResource AccentSoftBrush}"
                            BorderBrush="{DynamicResource AccentBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="32">
                        <Viewbox Margin="15">
                            <Canvas Width="32" Height="32">
                                <Path Stroke="{DynamicResource AccentBrush}"
                                      StrokeThickness="2.4"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Fill="Transparent"
                                      Data="M 9 14 H 22 V 20 C 22 23 20 25 17 25 H 13 C 10 25 8 23 8 20 V 14 Z M 22 16 H 24 C 26 16 27 17 27 19 C 27 21 26 22 24 22 H 22" />
                                <Path Stroke="{DynamicResource AccentBrush}"
                                      StrokeThickness="2.1"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Data="M 12 9 C 10 7 14 6 12 4 M 17 9 C 15 7 19 6 17 4 M 22 9 C 20 7 24 6 22 4" />
                            </Canvas>
                        </Viewbox>
                    </Border>

                    <TextBlock Text="休息一下吧"
                               Margin="0,22,0,0"
                               FontSize="34"
                               FontWeight="SemiBold" />
                    <TextBlock Text="看看远处，放松眼睛，活动一下肩颈。"
                               Margin="0,10,0,0"
                               TextWrapping="Wrap"
                               FontSize="16"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock x:Name="CountdownText"
                               Margin="0,28,0,0"
                               FontSize="76"
                               FontWeight="SemiBold"
                               FontFamily="Consolas"
                               Text="05:00" />

                    <StackPanel x:Name="ActionPanel"
                                Margin="0,28,0,0"
                                Orientation="Horizontal">
                        <Button Width="104"
                                Margin="0,0,10,0"
                                Style="{StaticResource OverlayButtonStyle}"
                                Click="OnCloseClick"
                                Content="关闭" />
                        <Button Width="124"
                                Margin="0,0,10,0"
                                Style="{StaticResource OverlayButtonStyle}"
                                Click="OnSnoozeClick"
                                Content="稍后提醒" />
                        <Button Width="144"
                                Style="{StaticResource PrimaryOverlayButtonStyle}"
                                Click="OnBreakClick"
                                Content="我去休息了" />
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Column="1"
                      Width="250"
                      Height="220"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Bottom">
                    <Ellipse Width="196"
                             Height="42"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Bottom"
                             Fill="#26000000" />
                    <Image x:Name="CharacterImage"
                           Width="230"
                           Height="190"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                           Stretch="Uniform" />
                </Grid>
            </Grid>
        </Border>

        <Border Margin="42"
                Padding="18,10"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Background="#33FFFFFF"
                BorderBrush="#55FFFFFF"
                BorderThickness="1"
                CornerRadius="20">
            <TextBlock Text="20-20-20：每 20 分钟看向 20 英尺外约 20 秒。"
                       FontSize="13"
                       Foreground="#F7F5F0" />
        </Border>
    </Grid>
</Window>
