<Window x:Class="ScreenTime.ReminderOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="休息提醒"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Maximized"
        Topmost="True"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent"
        KeyDown="OnKeyDown">
    <Grid x:Name="RootOverlay">
        <Border Width="560"
                Padding="42"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource OverlayCardBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <StackPanel HorizontalAlignment="Center">
                <Canvas Width="150" Height="96" Margin="0,0,0,20">
                    <Ellipse Width="72" Height="38" Canvas.Left="34" Canvas.Top="42" Fill="{DynamicResource ReminderCharacterBrush}" />
                    <Ellipse Width="36" Height="34" Canvas.Left="88" Canvas.Top="30" Fill="{DynamicResource ReminderCharacterBrush}" />
                    <Polygon Points="94,32 101,12 109,34" Fill="{DynamicResource ReminderCharacterBrush}" />
                    <Polygon Points="112,32 126,15 125,40" Fill="{DynamicResource ReminderCharacterBrush}" />
                    <Ellipse Width="5" Height="5" Canvas.Left="108" Canvas.Top="43" Fill="#79D58B" />
                    <Ellipse Width="5" Height="5" Canvas.Left="118" Canvas.Top="43" Fill="#79D58B" />
                    <Path Stroke="{DynamicResource ReminderCharacterBrush}" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M 36 56 C 12 52, 12 28, 36 34" />
                    <Path Stroke="{DynamicResource ReminderCharacterBrush}" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M 48 76 L 43 88 M 72 76 L 70 89 M 96 66 L 103 82" />
                </Canvas>

                <TextBlock Text="休息一下吧"
                           HorizontalAlignment="Center"
                           FontSize="30"
                           FontWeight="SemiBold" />
                <TextBlock Text="看看远处，放松眼睛，顺便活动一下肩颈。"
                           Margin="0,10,0,0"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           FontSize="15"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock x:Name="CountdownText"
                           Margin="0,28,0,0"
                           HorizontalAlignment="Center"
                           FontSize="58"
                           FontWeight="SemiBold"
                           FontFamily="Consolas"
                           Text="05:00" />

                <StackPanel x:Name="ActionPanel"
                            Margin="0,32,0,0"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal">
                    <Button Width="110" Margin="0,0,12,0" Click="OnCloseClick" Content="关闭" />
                    <Button Width="110" Margin="0,0,12,0" Click="OnSnoozeClick" Content="稍后提醒" />
                    <Button Width="140" Click="OnBreakClick" Content="我去休息了" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
