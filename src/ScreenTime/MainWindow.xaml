<Window x:Class="ScreenTime.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ScreenTime"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="屏幕时间"
        Icon="Assets/AppIcon.ico"
        Height="620"
        Width="1040"
        MinHeight="560"
        MinWidth="900"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    <Window.Resources>
        <local:ChartSegmentHeightConverter x:Key="ChartSegmentHeightConverter" />

        <Style x:Key="CardTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        </Style>

        <Style x:Key="CardValueStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10" />
            <Setter Property="MinWidth" Value="10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Opacity="0"
                                                  Command="{x:Static ScrollBar.PageUpCommand}" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Margin="2"
                                                        Background="{DynamicResource AccentBorderBrush}"
                                                        CornerRadius="4" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Opacity="0"
                                                  Command="{x:Static ScrollBar.PageDownCommand}" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="10" />
                    <Setter Property="MinHeight" Value="10" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListViewItem">
            <Setter Property="MinHeight" Value="46" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Row"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource AccentBorderBrush}"
                                BorderThickness="0"
                                CornerRadius="4">
                            <GridViewRowPresenter Margin="{TemplateBinding Padding}"
                                                  Content="{TemplateBinding Content}"
                                                  Columns="{Binding Path=View.Columns, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                <Setter TargetName="Row" Property="BorderThickness" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource PageBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8">
    <Grid ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Image x:Name="LiquidGlassBackdrop"
               Grid.RowSpan="3"
               Stretch="Fill"
               Opacity="0.94"
               IsHitTestVisible="False"
               Visibility="Collapsed">
            <Image.Effect>
                <BlurEffect Radius="5" />
            </Image.Effect>
        </Image>

        <Border Grid.RowSpan="3"
                Margin="28,44,28,28"
                Background="{DynamicResource DashboardGlassPanelBrush}"
                BorderBrush="{DynamicResource DashboardGlassPanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                IsHitTestVisible="False" />

        <Grid Background="Transparent"
              MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
            <StackPanel Orientation="Horizontal"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center">
                <Image Width="16"
                       Height="16"
                       Source="Assets/AppIcon.ico" />
                <TextBlock Text="屏幕时间"
                           Margin="7,0,0,0"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Style="{StaticResource CaptionButtonStyle}"
                        Content="&#xE921;"
                        Click="OnMinimizeClick" />
                <Button x:Name="MaximizeButton"
                        Style="{StaticResource CaptionButtonStyle}"
                        Content="&#xE922;"
                        Click="OnMaximizeClick" />
                <Button Style="{StaticResource CaptionCloseButtonStyle}"
                        Content="&#xE8BB;"
                        Click="OnCloseClick" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="28,20,28,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Padding="16,12"
                    Margin="0,0,12,0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="今日使用" Style="{StaticResource CardTitleStyle}" />
                    <TextBlock x:Name="TodayTimeText" Text="0 秒" Style="{StaticResource CardValueStyle}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    Padding="16,12"
                    Margin="4,0,8,0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="连续使用" Style="{StaticResource CardTitleStyle}" />
                    <TextBlock x:Name="ContinuousTimeText" Text="0 秒" Style="{StaticResource CardValueStyle}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Padding="16,12"
                    Margin="8,0,4,0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="下次休息" Style="{StaticResource CardTitleStyle}" />
                    <TextBlock x:Name="NextBreakText" Text="50 分钟" Style="{StaticResource CardValueStyle}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="3"
                    Padding="16,12"
                    Margin="12,0,0,0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="运行状态" Style="{StaticResource CardTitleStyle}" />
                    <TextBlock x:Name="StateText"
                               Margin="0,6,0,0"
                               Text="启动中"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock x:Name="StatusText"
                               Margin="0,4,0,0"
                               FontSize="12"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock x:Name="UpdateStatusText"
                               Margin="0,3,0,0"
                               FontSize="11"
                               FontWeight="SemiBold"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               Visibility="Collapsed"
                               Cursor="Hand"
                               MouseLeftButtonUp="OnUpdateStatusTextMouseLeftButtonUp"
                               Foreground="{DynamicResource AccentBrush}" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="28,0,28,28">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.25*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Padding="18"
                    Background="{DynamicResource DashboardSectionBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Bottom">
                        <TextBlock Text="屏幕时间"
                                   FontSize="20"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="PeriodLabelText"
                                   Margin="10,0,0,2"
                                   VerticalAlignment="Bottom"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="WeeklyModeButton"
                                Width="116"
                                Margin="0,0,8,0"
                                Style="{StaticResource RoundedButtonStyle}"
                                Click="OnWeeklyModeClick"
                                   Content="每周" />
                        <Button x:Name="DailyModeButton"
                                Grid.Column="1"
                                Width="116"
                                Margin="0,0,12,0"
                                Style="{StaticResource RoundedButtonStyle}"
                                Click="OnDailyModeClick"
                                Content="每日" />
                        <Button x:Name="PreviousPeriodButton"
                                Grid.Column="2"
                                Width="44"
                                Margin="0,0,8,0"
                                Style="{StaticResource RoundedButtonStyle}"
                                Click="OnPreviousPeriodClick"
                                Content="‹" />
                        <Button x:Name="NextPeriodButton"
                                Grid.Column="3"
                                Width="44"
                                Style="{StaticResource RoundedButtonStyle}"
                                Click="OnNextPeriodClick"
                                Content="›" />
                    </Grid>

                    <Border Grid.Row="2"
                            Margin="0,18,0,0"
                            Padding="14"
                            Background="{DynamicResource PageBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="PeriodTotalText"
                                       FontSize="28"
                                       FontWeight="SemiBold" />

                            <Grid Grid.Row="1" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="46" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" MinHeight="98" />
                                    <RowDefinition Height="22" />
                                </Grid.RowDefinitions>

                                <Grid x:Name="ChartPlotArea"
                                      ClipToBounds="True"
                                      SizeChanged="OnChartPlotAreaSizeChanged">
                                    <Line x:Name="AverageLine"
                                          X1="0"
                                          X2="1"
                                          Y1="0"
                                          Y2="0"
                                          Stretch="Fill"
                                          Stroke="{DynamicResource TextMutedBrush}"
                                          StrokeDashArray="4 4"
                                          StrokeThickness="1"
                                          Visibility="Collapsed" />
                                    <TextBlock x:Name="AverageLineText"
                                               HorizontalAlignment="Right"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Visibility="Collapsed" />

                                    <Grid IsHitTestVisible="False">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Border BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="0,1,0,0" />
                                        <Border Grid.Row="1"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="0,1,0,1" />
                                    </Grid>

                                    <ItemsControl x:Name="UsageBarsList">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="3,0"
                                                      Background="Transparent"
                                                      MouseLeftButtonUp="OnUsageBarClick">
                                                    <ItemsControl VerticalAlignment="Bottom"
                                                                  ItemsSource="{Binding Segments}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel VerticalAlignment="Bottom" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Width="{Binding Width}"
                                                                        HorizontalAlignment="Center"
                                                                        Background="{Binding Fill}">
                                                                    <Border.Height>
                                                                        <MultiBinding Converter="{StaticResource ChartSegmentHeightConverter}">
                                                                            <Binding Path="Seconds" />
                                                                            <Binding Path="AxisMaxSeconds" />
                                                                            <Binding RelativeSource="{RelativeSource AncestorType=Grid}" Path="ActualHeight" />
                                                                        </MultiBinding>
                                                                    </Border.Height>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>

                                <Grid Grid.Column="1"
                                      Margin="8,0,0,0">
                                    <TextBlock x:Name="ChartMaxText"
                                               VerticalAlignment="Top"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}" />
                                    <TextBlock x:Name="ChartMidText"
                                               VerticalAlignment="Center"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}" />
                                    <TextBlock x:Name="ChartMinText"
                                               Text="0"
                                               VerticalAlignment="Bottom"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}" />
                                </Grid>

                                <ItemsControl x:Name="XAxisLabelsList"
                                              Grid.Row="1"
                                              VerticalAlignment="Bottom"
                                              Margin="0,4,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock HorizontalAlignment="Center"
                                                       FontSize="11"
                                                       Text="{Binding}"
                                                       TextWrapping="NoWrap"
                                                       Foreground="{DynamicResource TextMutedBrush}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Grid.Row="1"
                                           Grid.Column="1"
                                           Margin="8,4,0,0"
                                           VerticalAlignment="Bottom"
                                           Text=""
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                            </Grid>
                        </Grid>
                    </Border>

                    <ItemsControl x:Name="CategoryStatsList"
                                  Grid.Row="3"
                                  Margin="0,22,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="4,0"
                                        Padding="6,4"
                                        Background="Transparent"
                                        BorderBrush="Transparent"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Cursor="Hand"
                                        MouseLeftButtonUp="OnCategoryStatClick">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}"
                                                   HorizontalAlignment="Center"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding Fill}" />
                                        <TextBlock HorizontalAlignment="Center"
                                                   Margin="0,4,0,0"
                                                   FontSize="12"
                                                   Text="{Binding Time}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Padding="14"
                    Background="{DynamicResource DashboardSectionBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="应用时长"
                               FontSize="20"
                               FontWeight="SemiBold" />

                    <ListView x:Name="TopAppsList"
                              Grid.Row="1"
                              Margin="0,16,0,0"
                              BorderThickness="0"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Hidden"
                              Background="Transparent"
                              Foreground="{DynamicResource TextPrimaryBrush}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="软件" Width="220">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="24" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="24"
                                                        Height="24"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        Background="{DynamicResource SurfaceAltBrush}"
                                                        CornerRadius="6">
                                                    <Image Width="20"
                                                           Height="20"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Source="{Binding Icon}" />
                                                </Border>
                                                <Grid Grid.Column="1"
                                                      Margin="8,0,0,0"
                                                      VerticalAlignment="Center">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="12"
                                                               LineHeight="14"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <Grid Grid.Row="1"
                                                          Margin="0,5,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="{Binding ProgressWidth}"
                                                                Height="5"
                                                                VerticalAlignment="Center"
                                                                Background="{DynamicResource UsageProgressBrush}"
                                                                CornerRadius="3" />
                                                        <TextBlock Grid.Column="1"
                                                                   Margin="4,0,0,0"
                                                                   FontSize="11"
                                                                   Text="{Binding Time}"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    </Grid>
                                                </Grid>
                                            </Grid>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="分类" DisplayMemberBinding="{Binding Category}" Width="52" />
                                <GridViewColumn Header="日均" DisplayMemberBinding="{Binding AverageTime}" Width="72" />
                                <GridViewColumn Header="占比" DisplayMemberBinding="{Binding Share}" Width="60" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
    </Border>
</Window>
