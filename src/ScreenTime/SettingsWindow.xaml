<Window x:Class="ScreenTime.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Icon="Assets/AppIcon.ico"
        Height="540"
        Width="900"
        MinHeight="540"
        MinWidth="900"
        MaxHeight="540"
        MaxWidth="900"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="40" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource InputBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid TextElement.Foreground="{TemplateBinding Foreground}">
                            <ToggleButton x:Name="ToggleButton"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          ClickMode="Press"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Chrome"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="6">
                                            <Path Width="8"
                                                  Height="5"
                                                  Margin="0,0,12,0"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  Data="M 0 0 L 4 4 L 8 0 Z"
                                                  Fill="{DynamicResource TextMutedBrush}" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SurfaceBrush}" />
                                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter Margin="12,0,34,0"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              IsHitTestVisible="False" />

                            <Popup AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{TemplateBinding ActualWidth}"
                                        Margin="0,4,0,0"
                                        Padding="4"
                                        Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <ScrollViewer CanContentScroll="True"
                                                  MaxHeight="220">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource PageBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8">
    <Grid ClipToBounds="True">
        <Image x:Name="LiquidGlassBackdrop"
               Stretch="Fill"
               Opacity="0.94"
               IsHitTestVisible="False"
               Visibility="Collapsed">
            <Image.Effect>
                <BlurEffect Radius="5" />
            </Image.Effect>
        </Image>

    <Grid Margin="28,0,28,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Background="Transparent"
              MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Image Width="16"
                       Height="16"
                       Source="Assets/AppIcon.ico" />
                <TextBlock Text="设置"
                           Margin="7,0,0,0"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Width="46"
                        Height="30"
                        MinHeight="30"
                        Padding="0"
                        BorderThickness="0"
                        Background="Transparent"
                        Content="—"
                        Click="OnMinimizeClick" />
                <Button Width="46"
                        Height="30"
                        MinHeight="30"
                        Padding="0"
                        BorderThickness="0"
                        Background="Transparent"
                        Content="×"
                        Click="OnCancelClick" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Padding="22"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="1.05*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="0.95*" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="提醒规则" FontSize="18" FontWeight="SemiBold" />
                    <CheckBox x:Name="ReminderEnabledBox" Content="开启休息提醒" Margin="0,16,0,8" />
                    <CheckBox x:Name="AllowCloseBox" Content="允许提前关闭提醒" Margin="0,0,0,18" />

                    <TextBlock Text="连续使用多久后提醒" FontWeight="SemiBold" />
                    <Grid Margin="0,8,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="48" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ReminderIntervalBox"
                                 MaxLength="3"
                                 InputScope="Number"
                                 ToolTip="请输入 1 到 240 之间的整数" />
                        <TextBlock Grid.Column="1"
                                   Text="分钟"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                    </Grid>

                    <TextBlock Text="休息倒计时时长" FontWeight="SemiBold" />
                    <Grid Margin="0,8,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="48" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="BreakDurationBox"
                                 MaxLength="2"
                                 InputScope="Number"
                                 ToolTip="请输入 1 到 60 之间的整数" />
                        <TextBlock Grid.Column="1"
                                   Text="分钟"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                    </Grid>

                    <TextBlock Text="无输入多久后视为空闲" FontWeight="SemiBold" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="48" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="IdleThresholdBox"
                                 MaxLength="4"
                                 InputScope="Number"
                                 ToolTip="请输入 10 到 3600 之间的整数" />
                        <TextBlock Grid.Column="1"
                                   Text="秒"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                    </Grid>
                </StackPanel>

                <Border Grid.Column="1"
                        Width="1"
                        Background="{DynamicResource BorderBrush}" />

                <StackPanel Grid.Column="2">
                    <TextBlock Text="外观与提醒" FontSize="18" FontWeight="SemiBold" />

                    <TextBlock Text="软件主题" Margin="0,16,0,8" FontWeight="SemiBold" />
                    <ComboBox x:Name="ThemeModeBox">
                        <ComboBoxItem Content="跟随系统" Tag="system" />
                        <ComboBoxItem Content="浅色" Tag="light" />
                        <ComboBoxItem Content="深色" Tag="dark" />
                        <ComboBoxItem Content="液态玻璃" Tag="liquid_glass" />
                    </ComboBox>

                    <!--
                    <TextBlock Text="提醒形象" Margin="0,16,0,8" FontWeight="SemiBold" />
                    <ComboBox x:Name="ReminderCharacterBox">
                        <ComboBoxItem Content="小猫" Tag="cat" />
                        <ComboBoxItem Content="小狗" Tag="dog" />
                    </ComboBox>
                    -->

                    <TextBlock Text="提醒遮罩透明度" Margin="0,18,0,8" FontWeight="SemiBold" />
                    <Slider x:Name="OverlayOpacitySlider"
                            Minimum="0.2"
                            Maximum="0.6"
                            TickFrequency="0.05"
                            IsSnapToTickEnabled="True" />
                    <Grid Margin="0,4,0,16">
                        <TextBlock Text="柔和"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBlock Text="明显"
                                   HorizontalAlignment="Right"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                    </Grid>

                    <CheckBox x:Name="TrayAnimationBox" Content="启用托盘提醒动画" />
                </StackPanel>

                <Border Grid.Column="3"
                        Width="1"
                        Background="{DynamicResource BorderBrush}" />

                <StackPanel Grid.Column="4">
                    <TextBlock Text="系统行为" FontSize="18" FontWeight="SemiBold" />
                    <CheckBox x:Name="MinimizeToTrayBox" Content="最小化到系统托盘" Margin="0,16,0,8" />
                    <CheckBox x:Name="LaunchAtStartupBox" Content="开机自启动" Margin="0,0,0,24" />

                    <TextBlock Text="隐私与数据" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="只统计软件级使用时长，数据保存在本机 AppData。"
                               Margin="0,8,0,12"
                               TextWrapping="Wrap"
                               FontSize="13"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <Border Padding="12"
                            Background="{DynamicResource AccentSoftBrush}"
                            BorderBrush="{DynamicResource AccentBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="会记录"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Text="软件名、进程名、可执行路径、活跃秒数、分类和提醒记录。"
                                       Margin="0,6,0,12"
                                       FontSize="12"
                                       LineHeight="18"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="不会记录"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Text="键盘内容、截图录屏、聊天文档内容、浏览器 URL 或云端账号数据。"
                                       Margin="0,6,0,0"
                                       FontSize="12"
                                       LineHeight="18"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="ErrorText"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource DangerBrush}"
                       TextWrapping="Wrap" />

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Width="88"
                        Height="36"
                        MinHeight="36"
                        Margin="0,0,10,0"
                        Click="OnCancelClick"
                        Content="取消" />
                <Button Width="88"
                        Height="36"
                        MinHeight="36"
                        Click="OnSaveClick"
                        Content="保存" />
            </StackPanel>
        </Grid>
    </Grid>
    </Grid>
    </Border>
</Window>
